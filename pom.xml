<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.santiago</groupId>
    <artifactId>ejerciciosjstl2</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>Ejercicios JSTL 2</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Servlet API: la provee el contenedor (Tomcat 9), no se empaqueta -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL 1.2 (namespace javax.servlet.jsp.jstl, compatible con Tomcat 9) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Driver MySQL Connector/J 8.4.0 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Genera target/ROOT.war para desplegar en la raíz del contexto -->
        <finalName>ROOT</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- La app es un webapp "exploded" en la raíz del repo, no en src/main/webapp -->
                    <warSourceDirectory>${project.basedir}</warSourceDirectory>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!-- Evita empaquetar metadatos del repo y los jars duplicados de WEB-INF/lib
                         (las dependencias las aporta Maven desde el pom) -->
                    <warSourceExcludes>
                        target/**,
                        .git/**,
                        pom.xml,
                        Dockerfile,
                        .dockerignore,
                        .gitignore,
                        AGENTS.md,
                        README.md,
                        WEB-INF/lib/**
                    </warSourceExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
